# 自建部署环境变量模板（复制为 .env 填真实值；.env 不入库，真实值另存 secrets/server-access.md）
PG_PASSWORD=<生成 24 位随机>

# 家庭身份（02 §3.2；FAMILY_ID 须与 families 行一致；FAMILY_SECRET 为 App 首配输入的家庭口令）
FAMILY_ID=family-default
FAMILY_SECRET=<家庭口令>

# 令牌哈希环境级盐（任意长随机串；改动会使全部旧 token 失效）
TOKEN_SALT=<64 位随机 hex>

# backup 端点 Bearer 令牌
BACKUP_TOKEN=<32 位随机>

# 站点地址：:80 = HTTP；改为域名后 Caddy 自动签发 HTTPS
SITE_ADDRESS=:80
