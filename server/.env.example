# CloudBase 环境（复制为 .env 并填真实值；.env 不入库）
TCB_ENV_ID=health-care-d0gccnchda96e436a

# 托管 PostgreSQL 连接串（云函数内由环境变量注入；本地调试用）
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# 家庭口令（auth 函数校验用）
FAMILY_SECRET=changeme

# 家庭 id（单家庭部署；families 表内该行的 id）
FAMILY_ID=

# 令牌哈希环境级盐（生产必配；任意长随机串）
TOKEN_SALT=

# backup 函数（可选）
BACKUP_TOKEN=
BACKUP_STORAGE=fs
BACKUP_FS_DIR=./backups
PG_DUMP_PATH=pg_dump
